{
  // Deliberately NOT named wrangler.jsonc.
  //
  // vinext refuses to build when a wrangler config sits in the project root
  // without the Cloudflare Vite plugin also being registered — a good default
  // for a Workers-only project, and the reason the Vercel build failed: the
  // Vercel branch of vite.config.ts drops that plugin on purpose. The guard
  // matches wrangler.jsonc / wrangler.json / wrangler.toml / cloudflare.config.ts
  // by name, so the file keeps its place (every path below stays root-relative)
  // and loses the name. Both the plugin and the CLI are pointed here explicitly:
  // `configPath` in vite.config.ts, `-c` in the npm scripts.
  //
  // This file is the SOURCE config. `wrangler deploy` must not be pointed at
  // it: `main` below is a package specifier that the Cloudflare Vite plugin
  // resolves during the build, and wrangler on its own reports it as a missing
  // entry point. The build emits the resolved config at
  // `dist/server/wrangler.json` — with main, the assets directory, cache and
  // observability all filled in — and that is what `npm run deploy` deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name `costanswer`. costanswer.com is not a zone on this account yet
  // (unregistered as of 2026-09-07). After it is, add:
  // "routes": [
  //   { "pattern": "costanswer.com", "custom_domain": true },
  //   { "pattern": "www.costanswer.com", "custom_domain": true }
  // ]
  "name": "costanswer",
  "account_id": "d1a5f19dd2081a3862da14682c9d76e0",
  // The newest date the installed workerd supports. Set it to today and the
  // runtime refuses to start at all — "requires compatibility date 2026-09-07,
  // but the newest date supported by this server binary is 2026-09-04" — which
  // takes the dev server and the whole browser suite with it. A compatibility
  // date is meant to be one the code has actually run against, so it moves when
  // the runtime is upgraded and not before.
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  // Must match vite.config.ts (`vinext/server/app-router-entry`).
  "main": "vinext/server/app-router-entry",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Salary occupation/state/leaf pages rely on s-maxage. Without this the
  // Worker Cache API is not exposed and those headers are a no-op.
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
