# Public, trusted production origin used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://costanswer.com

# Ingestion-only secret for EIA Open Data. Electricity retail-sales ingest
# requires this key. Gasoline prefers the same API (petroleum/pri/gnd weekly
# regular all-formulations series) and falls back to EIA's public HTML table
# when the key is missing or API coverage is incomplete.
# Never expose this in client code or commit a real value.
EIA_API_KEY=replace-with-a-free-eia-api-key

# BLS Average Price Data uses the public API without a key (25 series/request).
# Grocery ingest batches series automatically. Refresh with: npm run data:bls-grocery
# CPI-U historical body comes from the official BLS time-series file
# (download.bls.gov cu.data.1.AllItems, series CUUR0000SA0). Recent months can
# overlay from the BLS public API: npm run data:bls-cpi
# Freddie Mac PMMS weekly rates are read from the public PMMS page (no key):
#   npm run data:pmms
# Tax snapshots are year-keyed official releases, not part of weekly refresh:
#   npm run data:tax
# Refresh scheduled official snapshots from ingest scripts, never from a user request:
#   npm run data:refresh
# GitHub Actions runs that command weekly and opens a PR when a newer period exists.
# Store EIA_API_KEY as a repository secret named EIA_API_KEY.

# Optional third-party analytics, advertising, and affiliate/lead-gen slots.
# Leave unset or blank to keep them off. Setting any of these flags to "true"
# also requires a real privacy date, public contact email, and policy version.
# Empty strings are treated as unset.
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_ADVERTISING_ENABLED=false
# NEXT_PUBLIC_AFFILIATES_ENABLED=false
# NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=2026-09-02
# NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com
# Public inbox for corrections, calculator requests, complaints, and suggestions.
# The contact form opens a mail message to this address. Leave unset to keep
# the form in copy-only mode. Ads, analytics, and affiliates also require this address.
# NEXT_PUBLIC_PRIVACY_POLICY_VERSION=1
#
# Affiliate program URLs — only used when NEXT_PUBLIC_AFFILIATES_ENABLED=true.
# Example partner names in code (LendingTree, Rocket Mortgage, SoFi, Bankrate)
# are placeholders, not live deals. Do not invent click-tracking IDs.
# NEXT_PUBLIC_AFFILIATE_LENDINGTREE_URL=
# NEXT_PUBLIC_AFFILIATE_ROCKET_MORTGAGE_URL=
# NEXT_PUBLIC_AFFILIATE_SOFI_URL=
# NEXT_PUBLIC_AFFILIATE_BANKRATE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# MONETIZATION
#
# Every value below is server-only unless its name starts with NEXT_PUBLIC_.
# Nothing here is required to run or build the site: with all of it unset, every
# calculator works exactly as it does now and no commercial module renders.
#
# Two rules the code enforces rather than trusts:
#   - a channel that is off in the environment cannot be switched on from the
#     admin endpoint. Stored overrides can only ever turn something off.
#   - no lead is collected without a D1 binding, because a consent record that
#     is not stored is not a consent record.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. Every other monetization flag is a child of this one.
# Required: no (default off). Server-only.
# MONETIZATION_ENABLED=false

# Peppers the one-way hashes used for duplicate detection, suppression and
# rate limiting. Minimum 32 characters. Generate once and never rotate casually:
# changing it orphans every existing suppression record and duplicate hash.
# Required: yes, before any lead endpoint will accept a submission. Server-only.
# MONETIZATION_HASH_PEPPER=generate-a-long-random-string-at-least-32-chars

# Bearer token for the admin and drain endpoints. Minimum 32 characters.
# Without it those endpoints return 404 rather than advertising their existence.
# Required: yes, to use the admin endpoint. Server-only.
# MONETIZATION_ADMIN_TOKEN=generate-a-long-random-string-at-least-32-chars

# Lets the mock lead provider run outside development. It accepts real contact
# details and discards them, so this must never be set on a live site.
# Required: no. Server-only.
# MONETIZATION_ALLOW_MOCKS=false

# ── Leads ───────────────────────────────────────────────────────────────────
# Required: no (default off). Server-only.
# LEADS_ENABLED=false
# LEADS_MOCK_ENABLED=false
# LEADS_GENERIC_ENABLED=false

# Angi. Status: configuration_required. Lead-auction API documentation is
# account-gated; see docs/PROVIDER_ONBOARDING.md for what is still needed.
# LEADS_ANGI_ENABLED=false
# LEADS_ANGI_API_KEY=
# LEADS_ANGI_ENDPOINT_ID=
# LEADS_ANGI_WEBHOOK_SECRET=

# LeadBank. Status: configuration_required. No public posting specification.
# LEADS_LEADBANK_ENABLED=false
# LEADS_LEADBANK_API_KEY=
# LEADS_LEADBANK_ENDPOINT_ID=
# LEADS_LEADBANK_WEBHOOK_SECRET=

# Home Services Lead Group. Status: configuration_required. Server-to-server
# posting specification is account-gated.
# LEADS_HSLG_ENABLED=false
# LEADS_HSLG_API_KEY=
# LEADS_HSLG_ENDPOINT_ID=
# LEADS_HSLG_WEBHOOK_SECRET=

# ── Pay per call ────────────────────────────────────────────────────────────
# Tracked numbers are provisioned by a provider and stored as call campaigns.
# Never hardcode a phone number. Required: no. Server-only.
# CALLS_ENABLED=false

# ── Affiliate ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_AFFILIATES_ENABLED above is the parent switch and also requires a
# privacy date, a contact address and a policy version.
# Required: no (default off). Server-only unless noted.
# AFFILIATE_AMAZON_ENABLED=false
# AFFILIATE_HOMEDEPOT_ENABLED=false
# AFFILIATE_CJ_ENABLED=false

# Financial affiliate offers (mortgage, loan and debt marketplaces) are gated
# separately and stay off until the business model and any licensing
# implications have been reviewed. Approved advertising is unaffected.
# AFFILIATE_FINANCIAL_ENABLED=false

# Amazon Associates. Status: configuration_required. Their programme evaluates
# an application after qualifying sales, so apply once the site has traffic.
# Server-only: affiliate links are built during server rendering, so the
# tracking id never needs to reach the browser.
# AFFILIATE_AMAZON_TRACKING_ID=

# Home Depot and CJ. Status: configuration_required. Link formats are issued at
# approval and are not guessed in code.
# AFFILIATE_HOMEDEPOT_TRACKING_ID=
# AFFILIATE_CJ_PUBLISHER_ID=
# AFFILIATE_CJ_WEBSITE_ID=

# ── Display advertising ─────────────────────────────────────────────────────
# One active network at a time; most programmes require exclusivity.
# One of: adsense | mediavine-journey | raptive. Required: no. Server-only.
# AD_PROVIDER=
# ADSENSE_CLIENT_ID=
# MEDIAVINE_SITE_ID=
# RAPTIVE_SITE_ID=
